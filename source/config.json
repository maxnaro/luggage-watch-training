{
    "train": {
        "data": "/app/data/dataset.yaml",
        "model": "yolo26m.pt",
        "epochs": 150,
        "patience": 40,
        "batch": 0.8,
        "imgsz": 640,
        "optimizer": "AdamW",
        "lr0": 0.0008,
        "lrf": 0.01,
        "warmup_epochs": 5.0,
        "freeze": 5,
        "workers": 8,
        "cache": "disk",
        "seed": 0,
        "resume": false,
        "exist_ok": false,
        "save_period": -1,
        "close_mosaic": 20,
        "iou": 0.8,
        "label_smoothing": 0.05,
        "cls": 0.5,
        "scale": 0.5,
        "device": "0",
        "perspective": 0.001,
        "shear": 10.0,
        "degrees": 15.0,
        "copy_paste": 0.2,
        "multi_scale": true,
        "box": 10.0,
        "name": "luggage_detection_26m"
    },
    "export": {
        "size": [640, 640],
        "opset": 18,
        "simplify": true,
        "dynamic": false,
        "batch": 1,
        "out": "/app/model/luggage_detection.onnx"
    }
}