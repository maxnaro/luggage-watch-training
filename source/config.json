{
    "train": {
        "data": "/app/data/dataset.yaml",
        "model": "yolo26n.pt",
        "epochs": 200,
        "patience": 30,
        "batch": 0.95,
        "imgsz": 640,
        "optimizer": "AdamW",
        "lr0": 0.0008,
        "lrf": 0.01,
        "warmup_epochs": 3.0,
        "freeze": 0,
        "workers": 8,
        "cache": "disk",
        "seed": 0,
        "resume": false,
        "exist_ok": false,
        "save_period": -1,
        "close_mosaic": 20,
        "iou": 0.7,
        "label_smoothing": 0.0,
        "cls": 0.5,
        "scale": 0.2,
        "device": "0",
        "perspective": 0.002,
        "shear": 5.0,
        "degrees": 45.0,
        "copy_paste": 0.3,
        "multi_scale": false,
        "flipud": 0.5,
        "box": 7.5,
        "name": "rebalanced_loss_26n"
    },
    "export": {
        "size": [640, 640],
        "opset": 18,
        "simplify": true,
        "dynamic": false,
        "batch": 1,
        "out": "/app/model/luggage_detection.onnx"
    }
}