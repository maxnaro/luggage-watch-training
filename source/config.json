{
    "phase1_coco_baseline": {
        "data": "/app/data/dataset.yaml",
        "model": "yolo26s.pt",
        "epochs": 150,
        "patience": 30,
        "batch": 0.95,
        "imgsz": 640,
        "optimizer": "AdamW",
        "lr0": 0.0008,
        "lrf": 0.01,
        "warmup_epochs": 3.0,
        "freeze": 0,
        "workers": 8,
        "cache": "disk",
        "seed": 0,
        "resume": false,
        "exist_ok": false,
